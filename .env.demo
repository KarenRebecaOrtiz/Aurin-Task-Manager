# =============================================================================
# Aurin Task Manager - DEMO Environment Variables
# =============================================================================
# Copy this to .env.local to run in demo mode.
# =============================================================================

# Demo Mode Toggle
NEXT_PUBLIC_DEMO_MODE=true

# Demo Firebase (Client SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAtlYgoIvBOBQ9uaQnfBKpzJ0vTti5AgO8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demoaurintaskmanager.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demoaurintaskmanager
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demoaurintaskmanager.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=76333969725
NEXT_PUBLIC_FIREBASE_APP_ID=1:76333969725:web:16fa1ca7c1be6b5ca09554

# Demo Firebase (Admin SDK) — Fill with service account from Firebase Console
GCP_PROJECT_ID=demoaurintaskmanager
GCP_SERVICE_ACCOUNT_EMAIL=<your-service-account>@demoaurintaskmanager.iam.gserviceaccount.com
GCP_PRIVATE_KEY="<paste-private-key-here>"
FIREBASE_STORAGE_BUCKET=demoaurintaskmanager.firebasestorage.app

# Clerk — Dummy values (not used in demo mode, but prevents import errors)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy
CLERK_SECRET_KEY=sk_test_dummy
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard/tasks

# Notifications — Intentionally omitted (disables email + push automatically)
# EMAIL_USER=
# EMAIL_PASS=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# AI Chat — Set these if you want the chatbot to work in demo
# OPENAI_API_KEY=<your-openai-key>
# N8N_WEBHOOK_URL=<your-n8n-url>

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
